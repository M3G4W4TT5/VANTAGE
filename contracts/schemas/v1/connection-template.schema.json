{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vantage.local/schemas/v1/connection-template.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "connectorTypeId", "name", "schemaVersion", "settings"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "const": 1 },
    "connectorTypeId": { "enum": ["adsb-lol", "usgs-earthquakes"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "schemaVersion": { "const": 1 },
    "settings": { "type": "object" }
  }
}
