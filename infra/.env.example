# Generate the actual local configuration with node scripts/init-local.mjs.
POSTGRES_PASSWORD=replace-with-a-unique-local-password
VANTAGE_DB_PORT=54329
VANTAGE_HTTP_PORT=5080
# Generated stable ownership mapping. Preserve these on recovery; never assign on first login.
VANTAGE_OWNER_ID=generated-internal-user-uuid
VANTAGE_OWNER_SUBJECT=generated-keycloak-user-uuid
VANTAGE_IDENTITY_ISSUER=http://localhost:8180/realms/vantage
# Generated secrets. Changing these does not rotate an existing database role/client.
KEYCLOAK_DB_PASSWORD=generated-by-init-local
VANTAGE_OIDC_CLIENT_SECRET=generated-by-init-local
VANTAGE_APP_DB_PASSWORD=generated-by-init-local
# Bootstrap administrator and temporary operator credentials are generated separately in
# ignored infra/keycloak/.local/credentials.json; never commit or print that file.
# Registered aircraft adapter. Restart the API after changes.
VANTAGE_AIRCRAFT_PROVIDER=adsb-lol
VANTAGE_ADSB_ENABLED=true
VANTAGE_ADSB_POLL_SECONDS=30
# Registered earthquake adapter; normally one request/minute while demanded.
VANTAGE_EARTHQUAKE_PROVIDER=usgs-earthquakes
VANTAGE_USGS_ENABLED=true
VANTAGE_USGS_POLL_SECONDS=60
