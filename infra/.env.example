# Generate the actual local configuration with node scripts/init-local.mjs.
POSTGRES_PASSWORD=replace-with-a-unique-local-password
VANTAGE_DB_PORT=54329
VANTAGE_HTTP_PORT=5080
# Registered aircraft adapter. Restart the API after changes.
VANTAGE_AIRCRAFT_PROVIDER=adsb-lol
VANTAGE_ADSB_ENABLED=true
VANTAGE_ADSB_POLL_SECONDS=30
# Registered earthquake adapter; normally one request/minute while demanded.
VANTAGE_EARTHQUAKE_PROVIDER=usgs-earthquakes
VANTAGE_USGS_ENABLED=true
VANTAGE_USGS_POLL_SECONDS=60
